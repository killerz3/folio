# folio — self-hosted HTML artifact host
# Installed to /etc/systemd/system/folio.service by install.sh.
# Style modelled on /etc/systemd/system/babel-api.service.

[Unit]
Description=folio — self-hosted HTML artifact host
Documentation=file:///srv/folio/README.md
After=network-online.target
Wants=network-online.target
# Do not spin forever if the readiness check keeps failing.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=folio
Group=folio
WorkingDirectory=/srv/folio

# Defaults. /etc/folio/env is read afterwards and wins for any key it sets
# (it is where FOLIO_TOKEN lives; mode 0600 root:folio, read by PID 1 before
# privileges are dropped).
Environment=NODE_ENV=production
Environment=FOLIO_ADDR=127.0.0.1
Environment=FOLIO_PORT=8082
Environment=FOLIO_DATA=/srv/folio/docs
EnvironmentFile=/etc/folio/env

ExecStart=/usr/bin/node /srv/folio/src/server.js

# Startup readiness check: the unit is not considered started until the origin
# answers /healthz on the loopback address. --retry-connrefused keeps trying
# while the listener is still coming up; a hard failure here fails the unit
# loudly instead of leaving a dead service marked "running".
ExecStartPost=/usr/bin/curl -fsS --max-time 30 --retry 30 --retry-delay 1 --retry-connrefused -o /dev/null http://127.0.0.1:${FOLIO_PORT}/healthz

ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStartSec=45
TimeoutStopSec=15

Restart=always
RestartSec=3

# --- Resource limits ---
MemoryMax=512M
TasksMax=64

# --- Sandboxing ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027

# Loopback HTTP + local sockets only. AF_INET6 and AF_NETLINK are required for
# DNS resolution (getaddrinfo/getifaddrs) when FOLIO_ACCESS_TEAM enables JWKS fetch.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# Code is read-only to the service; only the doc root is writable.
ReadOnlyPaths=/srv/folio
ReadWritePaths=/srv/folio/docs

# --- Logging ---
StandardOutput=journal
StandardError=journal
SyslogIdentifier=folio

[Install]
WantedBy=multi-user.target
